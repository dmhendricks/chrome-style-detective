{
  "name": "style-detective",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "description": "Hover over any HTML element to inspect its computed CSS in a floating panel.",
  "license": "GPL-2.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "overrides": {
    "rollup": "^4.60.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "zod": "^4.4.3"
  }
}
