{
    "name": "Style Detective",
    "manifest_version": 3,
    "version": "1.8.0",
    "description": "Displays CSS style properties in an overlay when hovering over elements.",
    "icons": {
        "16": "images/16.png",
        "32": "images/32.png",
        "48": "images/48.png",
        "128": "images/128.png"
    },
    "options_page": "src/options/options.html",
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "action": {
        "default_icon": {
            "16": "images/16.png",
            "32": "images/32.png",
            "48": "images/48.png"
        },
        "default_title": "Style Detective"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*", "file://*/*"],
            "js": ["src/content/core.ts"],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "permissions": ["storage", "clipboardWrite", "scripting", "activeTab"],
    "host_permissions": ["http://*/*", "https://*/*", "file://*/*"],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "windows": "Ctrl+Shift+D",
                "mac": "Command+Shift+D",
                "chromeos": "Ctrl+Shift+D",
                "linux": "Ctrl+Shift+D"
            }
        }
    }
}
